// Launches the extension in a new window, with the demo files open.
// In this mode VS Code always applies the extension's first theme: pick another one
// with "Preferences: Color Theme", or use `npm run screenshots` to review them all.
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/demo"],
			"preLaunchTask": "build"
		}
	]
}
