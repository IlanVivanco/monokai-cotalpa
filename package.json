{
  "name": "cotalpa",
  "displayName": "Monokai Cotalpa",
  "description": "🎨 Yet another Monokai color scheme for VS Code.",
  "publisher": "ilanvivanco",
  "version": "2.2.0",
  "icon": "images/logo.png",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/IlanVivanco/monokai-cotalpa"
  },
  "bugs": {
    "url": "https://github.com/IlanVivanco/monokai-cotalpa/issues",
    "email": "ilanvivanco@gmail.com"
  },
  "galleryBanner": {
    "color": "#273136",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "Dark",
    "Light",
    "Italic",
    "Monokai"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Monokai Cotalpa",
        "uiTheme": "vs-dark",
        "path": "./themes/monokai-cotalpa-color-theme.json"
      },
      {
        "label": "Monokai Cotalpa Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/monokai-cotalpa-main-italic-color-theme.json"
      },
      {
        "label": "Monokai Cotalpa Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/monokai-cotalpa-main-dark-color-theme.json"
      },
      {
        "label": "Monokai Cotalpa Dark Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/monokai-cotalpa-main-dark-italic-color-theme.json"
      },
      {
        "label": "Monokai Cotalpa Coffee",
        "uiTheme": "vs-dark",
        "path": "./themes/monokai-cotalpa-coffee-dark-color-theme.json"
      },
      {
        "label": "Monokai Cotalpa Coffee Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/monokai-cotalpa-coffee-dark-italic-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "chroma-js": "^3.2.0",
    "fs-extra": "^11.4.1",
    "npm-watch": "^0.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "badges": [],
  "watch": {
    "build": "src/**/*.js"
  },
  "scripts": {
    "build": "node ./src/buildThemes.js",
    "watch": "npm-watch",
    "validate": "node ./scripts/validateThemes.js",
    "package": "vsce package",
    "screenshots": "node ./scripts/screenshots.js",
    "vscode:prepublish": "npm run build"
  }
}
